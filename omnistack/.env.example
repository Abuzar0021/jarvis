# ---------------------------------------------------------------------------
# OmniStack Digital — environment variables
# Copy this file to ".env.local" and fill in the values you need.
# The site runs fine with NONE of these set (sensible defaults are used),
# but you should set ADMIN_PASSWORD and ADMIN_SECRET before going live.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (used for canonical URLs + sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin / CMS login ------------------------------------------------------
# Password to sign in at /admin. CHANGE THIS before deploying.
ADMIN_PASSWORD=omnistack-admin
# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Email notifications (optional) -----------------------------------------
# When set, new contact-form enquiries are emailed to you. If left blank,
# enquiries are still saved and shown in /admin > Leads.
# For Gmail: create an App Password (Google Account > Security > App passwords)
# and use it as SMTP_PASS with SMTP_HOST=smtp.gmail.com, SMTP_PORT=465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where enquiries are delivered (defaults to the email set in /admin).
CONTACT_TO=abuzarelahi01@gmail.com

# --- Analytics (optional, privacy-friendly Umami) ---------------------------
# When both are set, a cookieless Umami script is loaded site-wide.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Spam protection (optional, Cloudflare Turnstile) -----------------------
# Forms already use a honeypot + rate limiting. Add Turnstile keys to enable
# an additional bot challenge.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Error monitoring (optional) --------------------------------------------
# Structured logs are emitted by default; set a Sentry DSN to forward errors.
SENTRY_DSN=
