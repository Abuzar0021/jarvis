# ── NVIDIA NIM (primary model stack) ─────────────────────────────────────────
# Get your key at https://build.nvidia.com — required for NIM models.
# Without this key the system falls back to OpenRouter automatically.
NVIDIA_NIM_API_KEY=nvapi-

# ── OpenRouter (fallback when NIM key is absent) ──────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-

# ── Model overrides (optional — defaults shown; all point at NIM) ─────────────
# Strong reasoning / planning (DeepSeek V4 Pro)
CEO_MODEL=nim/deepseek-ai/deepseek-v3-0324
RESEARCH_MODEL=nim/deepseek-ai/deepseek-v3-0324
DEBUG_MODEL=nim/deepseek-ai/deepseek-v3-0324
PROPOSAL_MODEL=nim/deepseek-ai/deepseek-v3-0324
DEFAULT_MODEL=nim/deepseek-ai/deepseek-v3-0324

# Fast execution / lead-gen / CRM (DeepSeek V4 Flash)
LEADGEN_MODEL=nim/deepseek-ai/deepseek-r1-0528
CRM_MODEL=nim/deepseek-ai/deepseek-r1-0528
SCORING_MODEL=nim/deepseek-ai/deepseek-r1-0528
AUDIT_MODEL=nim/deepseek-ai/deepseek-r1-0528
SALES_MODEL=nim/deepseek-ai/deepseek-r1-0528

# Code / tool generation (Qwen3 235B/22B-active)
CODING_MODEL=nim/qwen/qwen3-235b-a22b
FACTORY_MODEL=nim/qwen/qwen3-235b-a22b

# Vision / UI analysis (Qwen 2.5-VL 72B)
VISION_MODEL=nim/qwen/qwen2.5-vl-72b-instruct

# ── Safety ───────────────────────────────────────────────────────────────────
REQUIRE_APPROVAL=true

# ── Tuning ───────────────────────────────────────────────────────────────────
MAX_HISTORY=50
MAX_SUBTASKS=10
MAX_ITERATIONS=15
