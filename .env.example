# ── OpenRouter ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Model overrides (optional) ───────────────────────────────────────────────
CEO_MODEL=anthropic/claude-3.5-sonnet
RESEARCH_MODEL=anthropic/claude-3.5-sonnet
CODING_MODEL=anthropic/claude-3.5-sonnet
QA_MODEL=anthropic/claude-3-haiku
DEBUG_MODEL=anthropic/claude-3.5-sonnet
DEPLOYMENT_MODEL=anthropic/claude-3-haiku
MARKETING_MODEL=anthropic/claude-3-haiku
OUTREACH_MODEL=anthropic/claude-3-haiku
DATA_MODEL=anthropic/claude-3.5-sonnet
FACTORY_MODEL=anthropic/claude-3.5-sonnet
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# ── Safety ───────────────────────────────────────────────────────────────────
REQUIRE_APPROVAL=true

# ── Tuning ───────────────────────────────────────────────────────────────────
MAX_HISTORY=50
MAX_SUBTASKS=10
MAX_ITERATIONS=15
