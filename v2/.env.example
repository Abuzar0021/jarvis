# Jarvis V2 Environment Configuration
# Copy to .env and fill in real values

# ── Required ────────────────────────────────────────────────────────────────

# LLM provider (OpenRouter supports Anthropic, OpenAI, etc.)
OPENROUTER_API_KEY=sk-or-v1-...

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ─────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis_v2
POSTGRES_PASSWORD=jarvis

# ── Redis (optional — falls back to in-memory pub/sub) ──────────────────────

REDIS_URL=redis://localhost:6379/0

# ── Frontend ─────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_HOST=localhost:8000

# ── Optional ─────────────────────────────────────────────────────────────────

# Use Anthropic API directly instead of OpenRouter
# ANTHROPIC_API_KEY=sk-ant-...

# LLM model selection
DEFAULT_MODEL=anthropic/claude-sonnet-4-5
FAST_MODEL=anthropic/claude-haiku-4-5

# Browser (set to false for visible browser during dev)
PLAYWRIGHT_HEADLESS=true

# Debug logging
DEBUG=false

# Self-improvement thresholds
OPTIMIZER_MIN_SAMPLES=10
OPTIMIZER_IMPROVEMENT_THRESHOLD=0.05
